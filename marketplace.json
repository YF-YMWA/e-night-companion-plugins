{
  "version": 1,
  "name": "E Night Companion Plugins",
  "description": "ENbot / E Night Companion 的可选插件市场。插件不随主包发布。",
  "updatedAt": "2026-11-08",
  "plugins": [
    {
      "id": "demo-dice-notes",
      "name": "示例插件 · 掷骰子与便签",
      "version": "1.0.0",
      "description": "演示插件结构：掷骰子、便签工具和 onMessage 钩子。",
      "author": "ENbot",
      "capabilities": [
        "tools",
        "hooks"
      ],
      "permissions": [
        "none"
      ],
      "requires": {
        "core": "0.9.0",
        "runtime": []
      },
      "setup": "复制到 plugins/，重启服务后即可使用；不需要额外配置。",
      "download": "bundles/demo-dice-notes.zip",
      "path": "plugins/demo-dice-notes",
      "guide": "plugins/demo-dice-notes/GUIDE.md",
      "guideUrl": "https://github.com/YF-YMWA/e-night-companion-plugins/blob/main/plugins/demo-dice-notes/GUIDE.md",
      "license": "MIT",
      "homepage": "https://github.com/YF-YMWA/e-night-companion-plugins"
    },
    {
      "id": "embedding-ollama",
      "name": "Ollama Embedding",
      "version": "1.0.0",
      "description": "本地 Ollama embedding（推荐 bge-m3），用于记忆混合检索；不可用时自动退回本地哈希向量。",
      "author": "ENbot",
      "capabilities": [
        "embedding"
      ],
      "permissions": [
        "local-network"
      ],
      "requires": {
        "core": "0.9.60",
        "runtime": [
          "Ollama"
        ],
        "model": "bge-m3"
      },
      "setup": "安装 Ollama 并启动 11434，拉取 bge-m3；复制插件到 plugins/，开启 memory.embedding 后重启。",
      "download": "bundles/embedding-ollama.zip",
      "path": "plugins/embedding-ollama",
      "guide": "plugins/embedding-ollama/GUIDE.md",
      "guideUrl": "https://github.com/YF-YMWA/e-night-companion-plugins/blob/main/plugins/embedding-ollama/GUIDE.md",
      "license": "MIT",
      "homepage": "https://github.com/YF-YMWA/e-night-companion-plugins",
      "setupScript": "plugins/embedding-ollama/setup-ollama.ps1",
      "setupCommand": "powershell -ExecutionPolicy Bypass -File plugins/embedding-ollama/setup-ollama.ps1 -AutoStart",
      "setupNotes": "脚本下载 Ollama + bge-m3 到 %LOCALAPPDATA%\\ENbot\\Ollama，不放进插件包"
    },
    {
      "id": "tts-local",
      "name": "本地 TTS",
      "version": "1.0.0",
      "description": "把文字交给本机 TTS 服务合成，不需要云端 API Key；支持 GPT-SoVITS 和通用 POST /tts。",
      "author": "ENbot",
      "capabilities": [
        "tts"
      ],
      "permissions": [
        "local-network"
      ],
      "requires": {
        "core": "0.9.61",
        "runtime": [
          "GPT-SoVITS 或兼容 HTTP 服务"
        ]
      },
      "setup": "启动本地 TTS（GPT-SoVITS 默认 9880），复制插件到 plugins/，在语音设置选「本地插件」后重启。",
      "download": "bundles/tts-local.zip",
      "path": "plugins/tts-local",
      "guide": "plugins/tts-local/GUIDE.md",
      "guideUrl": "https://github.com/YF-YMWA/e-night-companion-plugins/blob/main/plugins/tts-local/GUIDE.md",
      "license": "MIT",
      "homepage": "https://github.com/YF-YMWA/e-night-companion-plugins"
    },
    {
      "id": "tts-sing",
      "name": "本地唱歌",
      "version": "1.0.0",
      "description": "调用本机 RVC / So-VITS-SVC / DiffSinger 做歌声转换或合成；不含模型。",
      "author": "ENbot",
      "capabilities": [
        "singing"
      ],
      "permissions": [
        "local-network"
      ],
      "requires": {
        "core": "0.9.69",
        "runtime": [
          "RVC / So-VITS-SVC / DiffSinger"
        ]
      },
      "setup": "启动本地唱歌 HTTP 服务（示例 7890/sing），复制插件到 plugins/，重启；用 /api/admin/voice/sing 验证。",
      "download": "bundles/tts-sing.zip",
      "path": "plugins/tts-sing",
      "guide": "plugins/tts-sing/GUIDE.md",
      "guideUrl": "https://github.com/YF-YMWA/e-night-companion-plugins/blob/main/plugins/tts-sing/GUIDE.md",
      "license": "MIT",
      "homepage": "https://github.com/YF-YMWA/e-night-companion-plugins"
    },
    {
      "id": "tts-sing-cloud",
      "name": "云端唱歌",
      "version": "1.0.0",
      "description": "调用云端歌声合成/歌曲生成 HTTP API，不内置 Key；支持音频、base64、URL 三种返回。",
      "author": "ENbot",
      "capabilities": [
        "singing"
      ],
      "permissions": [
        "network"
      ],
      "requires": {
        "core": "0.9.69",
        "runtime": [
          "云端唱歌 API"
        ],
        "model": "按厂商"
      },
      "setup": "在 /voice-sing 填接口地址/Key，或配置 plugins.items[\"tts-sing-cloud\"]，重启。",
      "download": "bundles/tts-sing-cloud.zip",
      "path": "plugins/tts-sing-cloud",
      "guide": "plugins/tts-sing-cloud/GUIDE.md",
      "guideUrl": "https://github.com/YF-YMWA/e-night-companion-plugins/blob/main/plugins/tts-sing-cloud/GUIDE.md",
      "license": "MIT",
      "homepage": "https://github.com/YF-YMWA/e-night-companion-plugins"
    },
    {
      "id": "tts-cloud-clone",
      "name": "云端音色克隆",
      "version": "1.0.0",
      "description": "调用云端音色克隆 HTTP API，把参考音频注册成音色；不内置 Key；成功后写入语音包。",
      "author": "ENbot",
      "capabilities": [
        "voice-clone"
      ],
      "permissions": [
        "network"
      ],
      "requires": {
        "core": "0.9.69",
        "runtime": [
          "云端克隆 API"
        ],
        "model": "按厂商"
      },
      "setup": "复制到 plugins/，重启；调音台「云端音色克隆」填接口、Key、TTS 接口后创建。",
      "download": "bundles/tts-cloud-clone.zip",
      "path": "plugins/tts-cloud-clone",
      "guide": "plugins/tts-cloud-clone/GUIDE.md",
      "guideUrl": "https://github.com/YF-YMWA/e-night-companion-plugins/blob/main/plugins/tts-cloud-clone/GUIDE.md",
      "license": "MIT",
      "homepage": "https://github.com/YF-YMWA/e-night-companion-plugins"
    }
  ]
}
